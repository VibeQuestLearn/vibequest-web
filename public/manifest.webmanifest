{
  "name": "VibeQuest — AI Learning Workbench",
  "short_name": "VibeQuest",
  "description": "Install VibeQuest as a multi-ecosystem AI learning workbench for protocol learning, checkpoints, tutor help, and practical quests.",
  "id": "/?source=pwa",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#030d0b",
  "theme_color": "#030d0b",
  "orientation": "portrait-primary",
  "categories": ["education", "productivity", "developer"],
  "icons": [
    {
      "src": "/icons/vibequest-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/vibequest-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/vibequest-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Start Learning",
      "short_name": "Learn",
      "description": "Open the ecosystem learning selector.",
      "url": "/learn?source=pwa-shortcut",
      "icons": [{ "src": "/icons/vibequest-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Open your learner dashboard.",
      "url": "/dashboard?source=pwa-shortcut",
      "icons": [{ "src": "/icons/vibequest-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
