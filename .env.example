# Server-only Core target.
CORE_API_BASE_URL=http://localhost:8080

# Google OAuth and encrypted Auth.js session cookies.
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# Stable opaque user IDs. Share this base64url-encoded 32+ byte secret with Core.
IDENTITY_DERIVATION_SECRET=

# Short-lived Web-to-Core assertions. The first key signs; Core accepts every key.
# Format: key-id:base64url-encoded-32+-byte-key[,older-key:base64url-key]
CORE_ASSERTION_KEYS=
CORE_ASSERTION_ISSUER=vibequest-web
CORE_ASSERTION_AUDIENCE=vibequest-core
